<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Leitura da biblioteca de áudio -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Baixar letras e capas automaticamente da internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Playback em segundo plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Bluetooth: responder a botões do fone/carro -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- "Definir como toque de chamada": permissão especial, concedida só
         pela tela de configurações do sistema (não por um diálogo padrão) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- "Editar tags do arquivo": grava direto no arquivo com jaudiotagger
         (java.io.File puro, não passa pelo MediaStore). Em Android 9 e
         anteriores basta a permissão comum abaixo; em Android 11+ precisa
         da permissão especial de "Acesso a todos os arquivos", concedida
         pela tela de configurações do sistema. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Em vários Android (Xiaomi, Samsung, etc), otimização de bateria
         agressiva mata o serviço de reprodução em segundo plano, o que
         também derruba a notificação com os controles de play/pause. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".HarmonicApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Harmonic"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Harmonic"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Permite que o Music Box apareça na lista de "Abrir com" ao
                 tocar num arquivo de áudio em outro app (gerenciador de
                 arquivos, e-mail, Drive, WhatsApp, etc). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Tela de erro exibida quando o app trava (em vez de só fechar) -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Serviço de reprodução: sobrevive com o app em segundo plano,
             expõe a MediaSession usada pela notificação, tela bloqueada,
             Bluetooth e Android Auto -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>

        <!-- Necessário pra compartilhar playlists exportadas em M3U com
             outros apps (WhatsApp, Drive, e-mail, etc) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Widgets de tela inicial: pequeno, médio e grande — cada um com
             seu próprio receiver, pra aparecerem como opções separadas no
             seletor de widgets do sistema em vez de um só genérico.
             RemoteViews clássico (AppWidgetProvider), não mais Glance. -->
        <!-- exported="true" é obrigatório: a ação padrão do sistema
             (APPWIDGET_UPDATE) chega como broadcast do processo do
             launcher (UID diferente do nosso) — com exported="false" o
             Android descarta esse broadcast antes de entregar, e o widget
             nunca recebe as atualizações automáticas do sistema (resize,
             reinstalação, etc). Os toques nos botões (play/pause, próxima,
             anterior) usam PendingIntents explícitos criados pelo próprio
             app, então não dependem dessa flag. -->
        <receiver
            android:name=".widget.HarmonicWidgetSmallProvider"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/harmonic_widget_small_info" />
        </receiver>
        <receiver
            android:name=".widget.HarmonicWidgetMediumProvider"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/harmonic_widget_medium_info" />
        </receiver>
        <receiver
            android:name=".widget.HarmonicWidgetLargeProvider"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/harmonic_widget_large_info" />
        </receiver>

    </application>
</manifest>
