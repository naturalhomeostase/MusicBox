<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Android 13+: quando o usuário liga "ícones com a cor do tema" nas
         configurações, o sistema ignora o background/foreground coloridos
         acima e usa só esta camada (silhueta em alfa) tingida na cor do
         papel de parede/tema escolhido. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
