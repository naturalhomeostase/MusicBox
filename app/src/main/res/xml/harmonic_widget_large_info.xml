<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão horizontal maior — capa grande à esquerda, texto e controles à
     direita. Antes era 4x4 (quadrado perfeito), o oposto do "mais
     horizontal" que faz sentido pra um widget de música. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="280dp"
    android:minHeight="130dp"
    android:targetCellWidth="5"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_large"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_large_description"
    android:previewLayout="@layout/widget_large"
    android:previewImage="@drawable/widget_preview" />
