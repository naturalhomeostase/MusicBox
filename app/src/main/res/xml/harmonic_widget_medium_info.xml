<?xml version="1.0" encoding="utf-8"?>
<!-- Barra horizontal e curta (1 linha) — capa + título/artista + controles
     lado a lado, como o "now playing" compacto de outros apps de música.
     Antes era 4x2 (quase quadrado), o que obrigava um layout empilhado
     (texto em cima, botões embaixo) bem menos natural pra esse tamanho. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_medium"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_medium_description"
    android:previewLayout="@layout/widget_medium"
    android:previewImage="@drawable/widget_preview" />
